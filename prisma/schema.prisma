// Radar MSA — modelo de dados
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// Analista da MSA: faz login, lança suas demandas e recebe os alertas.
/// Quem lança é quem é alertado — por isso login e destinatário são a mesma entidade.
model Usuario {
  id        String   @id @default(cuid())
  email     String   @unique
  senhaHash String
  nome      String
  equipe    String?
  /// ANALISTA vê apenas as próprias demandas; ADMIN vê as de todo o time.
  perfil    String   @default("ANALISTA") // ANALISTA | ADMIN
  ativo     Boolean  @default(true)
  /// Foto de perfil como data URI (data:image/...;base64,...), redimensionada
  /// no navegador antes do envio. Nulo = avatar de iniciais.
  avatar    String?
  /// Libera os recursos ainda em avaliação para esta conta — hoje, a área
  /// "Meus arquivos" e o anexar a partir do Google Drive. Fica por pessoa
  /// porque são telas em validação, mostradas primeiro na conta de
  /// demonstração antes de valerem para todo o time.
  recursosExperimentais Boolean @default(false)
  criadoEm  DateTime @default(now())

  demandas  Demanda[]
  alertas   Alerta[]
  anexos    Anexo[]
  comentarios Comentario[]
  recorrencias Recorrencia[]
  diasAtivos DiaAtivo[]
  progresso  Progresso?
  conquistas Conquista[]
  missoes    Missao[]
  mencoes    Mencao[]
  linksGerados      LinkAcesso[] @relation("AdminDoLink")
  linksRecebidos    LinkAcesso[] @relation("AlvoDoLink")

  @@index([ativo])
}

/// Um dia em que a pessoa trabalhou no Radar — criou, editou, concluiu,
/// comentou ou anexou algo. É o que alimenta a Ofensiva Radar.
///
/// Uma linha por pessoa por dia: a chave única deixa o registro ser idempotente,
/// então marcar o mesmo dia várias vezes não duplica nada.
model DiaAtivo {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Dia no fuso do produto, à meia-noite UTC.
  dia       DateTime
  /// Quantas ações aconteceram no dia, só para leitura futura.
  acoes     Int      @default(1)

  criadoEm  DateTime @default(now())

  @@unique([usuarioId, dia])
  @@index([usuarioId, dia])
}

/// Demanda lançada por um analista, com data de início e prazo de entrega.
model Demanda {
  id           String    @id @default(cuid())
  titulo       String
  descricao    String?
  prioridade   String    @default("MEDIA")  // BAIXA | MEDIA | ALTA | CRITICA
  status       String    @default("ABERTA") // ABERTA | EM_ANDAMENTO | CONCLUIDA | CANCELADA
  origem       String    @default("MANUAL") // MANUAL | TEAMS | GOOGLE_CHAT
  solicitante  String?
  categoria    String?

  /// Data de início prevista da entrega. Opcional: demandas antigas não a têm.
  inicio       DateTime?
  /// Prazo de entrega. Vencido este dia sem conclusão, dispara o alerta.
  prazo        DateTime
  concluidaEm  DateTime?
  /// Quantos alertas de vencimento já foram enviados para esta demanda.
  vezesAlertada Int      @default(0)
  /// Quantas vezes um analista adiou o prazo. Adiamentos feitos por admin não
  /// contam: são decisão da gestão, não sinal de que o prazo está sendo empurrado.
  reagendamentos Int     @default(0)

  /// Quem lançou a demanda — e quem recebe o alerta.
  autorId      String
  autor        Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  anexos       Anexo[]
  comentarios  Comentario[]
  historicoPrazo Reagendamento[]

  /// Preenchido quando a demanda nasceu de uma regra de recorrência.
  recorrenciaId String?
  recorrencia   Recorrencia? @relation(fields: [recorrenciaId], references: [id], onDelete: SetNull)

  @@index([status, prazo])
  @@index([autorId, prazo])
  @@index([recorrenciaId])
}

/// Cada troca da data de entrega de uma demanda, feita por qualquer pessoa.
///
/// Existe para o admin enxergar quem vive empurrando prazo: o analista não
/// pode mais mexer na entrega no dia do vencimento, mas ainda pode adiar na
/// véspera, todo dia, e nunca ter nada atrasado. `diasAntes` é o que denuncia
/// esse padrão — adiamento com 1 dia de antecedência é o sinal de alerta.
model Reagendamento {
  id            String   @id @default(cuid())
  demandaId     String
  demanda       Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  prazoAnterior DateTime
  prazoNovo     DateTime
  /// Quantos dias faltavam para o prazo anterior quando ele foi trocado.
  diasAntes     Int

  /// Mesmo critério do comentário: removida a conta, o registro fica e
  /// `usuarioNome` preserva a autoria.
  usuarioId     String?
  usuarioNome   String
  /// Perfil de quem trocou, no momento da troca — admin pode mudar livremente.
  perfil        String
  /// Admin por trás da troca, quando ela foi feita por link de acesso.
  personificadoPor String?

  criadoEm      DateTime @default(now())

  @@index([demandaId, criadoEm])
}

/// Regra que repete uma demanda no tempo. Guarda o molde (título, responsável,
/// prioridade…) e a cadência; as demandas em si são criadas pelo cron diário,
/// uma por vez, conforme a data chega.
model Recorrencia {
  id           String   @id @default(cuid())

  /// Molde da demanda gerada.
  titulo       String
  descricao    String?
  prioridade   String   @default("MEDIA")
  categoria    String?
  solicitante  String?

  /// DIARIA | SEMANAL | MENSAL | PERSONALIZADA
  frequencia   String
  /// Passo da cadência: a cada N dias/semanas/meses. 1 nos atalhos.
  intervalo    Int      @default(1)
  /// Dias da semana no modo semanal: 0 = domingo … 6 = sábado.
  diasSemana   Int[]    @default([])
  /// Dia do mês no modo mensal (1–31). Meses curtos caem no último dia.
  diaDoMes     Int?
  /// Pula sábado e domingo, empurrando para a segunda-feira seguinte.
  apenasDiasUteis Boolean @default(false)

  /// Primeira data da série e, opcionalmente, quando parar.
  inicio       DateTime
  fim          DateTime?
  /// Teto de ocorrências, alternativa à data de fim.
  maximo       Int?

  /// Última data já materializada, para o cron não repetir nem pular.
  ultimaGeracao DateTime?
  /// Quantas demandas a regra já criou.
  geradas      Int      @default(0)
  /// Pausada ou encerrada deixa de gerar, sem apagar o histórico.
  ativa        Boolean  @default(true)

  autorId      String
  autor        Usuario  @relation(fields: [autorId], references: [id], onDelete: Cascade)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  demandas     Demanda[]
  anexos       AnexoRecorrencia[]

  @@index([ativa, inicio])
  @@index([autorId])
}

/// Anexo do molde: fica guardado na regra e é copiado para cada demanda que
/// ela gera. Separado de Anexo porque aquele exige uma demanda, que aqui
/// ainda não existe quando o arquivo é escolhido.
model AnexoRecorrencia {
  id            String      @id @default(cuid())
  recorrenciaId String
  recorrencia   Recorrencia @relation(fields: [recorrenciaId], references: [id], onDelete: Cascade)

  nome          String
  tipo          String
  tamanho       Int
  /// Caminho do arquivo no bucket do R2, dividido com as demandas geradas.
  chave         String

  criadoEm      DateTime    @default(now())

  @@index([recorrenciaId])
  @@index([chave])
}

/// Arquivo anexado a uma demanda (até 10MB). O conteúdo fica no Cloudflare R2;
/// aqui ficam só os metadados e a chave do objeto no bucket.
model Anexo {
  id        String   @id @default(cuid())
  demandaId String
  demanda   Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  nome      String
  /// Tipo declarado pelo navegador; usado só para escolher o ícone e o download.
  tipo      String
  /// Tamanho em bytes do arquivo original, para exibir na lista.
  tamanho   Int
  /// Caminho do arquivo no bucket do R2. Pode repetir em outras linhas: as
  /// demandas de uma recorrência dividem o arquivo do molde.
  chave     String

  /// Quem anexou. Removida a conta, o anexo fica e `autorId` vira nulo —
  /// `autorNome` é quem preserva a autoria. (Se a conta removida for a do dono
  /// da demanda, a demanda inteira já cai por cascade e leva os anexos junto.)
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  autorNome String

  criadoEm  DateTime @default(now())

  @@index([demandaId, criadoEm])
  @@index([chave])
}

/// Comentário deixado numa demanda por quem tem acesso a ela.
model Comentario {
  id        String   @id @default(cuid())
  demandaId String
  demanda   Demanda  @relation(fields: [demandaId], references: [id], onDelete: Cascade)

  texto     String

  /// Mesmo critério do anexo: removida a conta de quem comentou, o texto fica
  /// e `autorId` vira nulo.
  autorId   String?
  autor     Usuario? @relation(fields: [autorId], references: [id], onDelete: SetNull)
  /// Nome capturado no momento do comentário, para o histórico não se perder.
  autorNome String

  criadoEm  DateTime @default(now())

  mencoes   Mencao[]

  @@index([demandaId, criadoEm])
}

/// Alguém marcado com @ dentro de um comentário.
///
/// Existe como tabela, e não como texto dentro do comentário, por dois
/// motivos: é ela que dá à pessoa mencionada acesso à demanda (ver
/// `lib/acesso.ts`), e é o que permite responder "quem já foi avisado" sem
/// reinterpretar o texto a cada leitura.
///
/// Apagado o comentário, a menção cai junto — e com ela o acesso que
/// concedia, a menos que outra menção na mesma demanda ainda exista.
model Mencao {
  id           String     @id @default(cuid())
  comentarioId String
  comentario   Comentario @relation(fields: [comentarioId], references: [id], onDelete: Cascade)

  /// Quem foi mencionado. Removida a conta, a menção some com ela: sem
  /// usuário não há acesso a conceder nem e-mail a enviar.
  usuarioId    String
  usuario      Usuario    @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  criadoEm     DateTime   @default(now())

  /// A mesma pessoa não é marcada duas vezes no mesmo comentário, mesmo que
  /// o nome dela apareça repetido no texto.
  @@unique([comentarioId, usuarioId])
  @@index([usuarioId])
}

/// Link de uso único que deixa um admin entrar como outra pessoa.
///
/// Serve ao suporte: ver e agir no Radar exatamente como o analista vê, para
/// reproduzir um problema. Como é um desvio da autenticação normal, cada link
/// é rastreado de ponta a ponta — quem gerou, para quem, quando foi usado e
/// de onde. Sem esse registro a personificação apagaria a autoria das ações.
///
/// O token nunca é guardado em claro: gravamos só o hash SHA-256. Vazado o
/// banco, os links não podem ser reaproveitados.
model LinkAcesso {
  id        String   @id @default(cuid())

  /// SHA-256 do token que vai na URL. O token em si só existe no momento da
  /// criação, quando é mostrado uma única vez ao admin.
  tokenHash String   @unique

  /// Quem gerou o link.
  adminId   String
  admin     Usuario  @relation("AdminDoLink", fields: [adminId], references: [id], onDelete: Cascade)
  /// Conta que será personificada.
  alvoId    String
  alvo      Usuario  @relation("AlvoDoLink", fields: [alvoId], references: [id], onDelete: Cascade)

  /// Prazo curto: o link morre sozinho mesmo que ninguém o use.
  expiraEm  DateTime
  /// Preenchido no primeiro uso. Não nulo = queimado, não serve mais.
  usadoEm   DateTime?
  /// IP de quem resgatou, para a trilha de auditoria.
  usadoIp   String?
  /// Revogado manualmente pelo admin antes de expirar.
  revogadoEm DateTime?

  criadoEm  DateTime @default(now())

  @@index([alvoId])
  @@index([adminId, criadoEm])
  @@index([expiraEm])
}

/// Registro de cada disparo, para auditoria e para evitar envio duplicado no mesmo dia.
model Alerta {
  id             String   @id @default(cuid())
  usuarioId      String
  usuario        Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  email          String
  /// Dia em que o alerta foi apurado.
  dataReferencia DateTime
  qtdDemandas    Int
  status         String   @default("ENVIADO") // ENVIADO | PREVIEW | ERRO
  detalhe        String?
  /// HTML da mensagem. Preenchido no modo preview, para conferência.
  corpoHtml      String?
  assunto        String?
  enviadoEm      DateTime @default(now())

  @@index([dataReferencia])
  @@unique([usuarioId, dataReferencia])
}

/// Progresso de gamificação de uma pessoa: XP acumulado e o nível que ele
/// concede. Uma linha por usuário, criada na primeira ação que dá XP.
///
/// O nível não é guardado como fonte da verdade — ele é derivado do XP em
/// `lib/gamificacao.ts`. Guardamos o XP porque é um acumulado histórico:
/// recalcular a partir das demandas perderia o XP de missões já resgatadas.
model Progresso {
  id        String   @id @default(cuid())
  usuarioId String   @unique
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// XP total acumulado desde sempre. Nunca diminui.
  xp        Int      @default(0)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt
}

/// Uma conquista desbloqueada. A linha só existe depois de conquistada —
/// as bloqueadas e em progresso são calculadas na hora, comparando o
/// catálogo de `lib/gamificacao.ts` com os números reais da pessoa.
model Conquista {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Chave do catálogo: 'primeiros-passos', '5-dias', etc.
  chave     String
  /// Quando a pessoa bateu o requisito.
  emQue     DateTime @default(now())

  @@unique([usuarioId, chave])
  @@index([usuarioId])
}

/// O progresso de uma pessoa numa missão. A definição (título, meta, XP)
/// vive no catálogo em código; aqui fica só o que muda por pessoa.
model Missao {
  id        String   @id @default(cuid())
  usuarioId String
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  /// Chave do catálogo: 'concluir-5-semana', 'ofensiva-15', etc.
  chave     String
  /// Quanto já foi feito. A meta vem do catálogo.
  progresso Int      @default(0)
  /// Preenchido quando a missão é concluída; nulo enquanto está ativa.
  concluidaEm DateTime?
  /// Evita pagar o XP duas vezes se o progresso for recalculado.
  xpCreditado Boolean @default(false)

  criadoEm     DateTime @default(now())
  atualizadoEm DateTime @updatedAt

  @@unique([usuarioId, chave])
  @@index([usuarioId])
}
