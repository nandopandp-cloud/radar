# ── Banco de dados ────────────────────────────────────────────────
DATABASE_URL="file:./dev.db"

# ── SMTP (deixe em branco para rodar em MODO PREVIEW) ─────────────
# Em modo preview nenhum e-mail é enviado: o HTML é gravado em .preview-emails/
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
MAIL_FROM="Radar MSA <radar-msa@exemplo.com>"

# Cópia oculta para gestores (opcional, separe por vírgula)
MAIL_BCC=""

# ── Agendador ─────────────────────────────────────────────────────
# Cron no fuso de SCHEDULER_TZ. Padrão: 08:00 em dias úteis.
SCHEDULER_CRON="0 8 * * 1-5"
SCHEDULER_TZ="America/Sao_Paulo"

# URL base usada pelo agendador para chamar a API
APP_URL="http://localhost:3000"

# Token simples para proteger o endpoint de disparo (opcional)
CRON_SECRET=""
