# ── Banco de dados (Postgres) ─────────────────────────────────────
# Neon, Vercel Postgres, Supabase… A connection string com pooling.
DATABASE_URL="postgresql://usuario:senha@host/banco?sslmode=require"
# Conexão direta, usada pelas migrations (o Neon fornece as duas).
DIRECT_URL="postgresql://usuario:senha@host/banco?sslmode=require"

# ── Autenticação ──────────────────────────────────────────────────
# OBRIGATÓRIO em produção. Gere com: openssl rand -base64 48
AUTH_SECRET=""

# Usados apenas pelo script db:seed-admin
ADMIN_EMAIL="admins@msa.com"
ADMIN_SENHA="12345"
ADMIN_NOME="Administrador MSA"

# Colaborador de teste que recebe os alertas (opcional)
COLABORADOR_TESTE_EMAIL=""
COLABORADOR_TESTE_NOME=""

# ── Envio de e-mail (deixe tudo em branco para rodar em MODO PREVIEW) ──
# Resend tem prioridade sobre SMTP quando ambos estão configurados.
# Recomendado: mais simples e sem fricção de conta de e-mail pessoal.
RESEND_API_KEY=""

# SMTP (alternativa ao Resend, ex: Gmail/Workspace com senha de app)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# Usado por Resend e SMTP. Com Resend, o domínio precisa estar verificado
# em resend.com/domains — senão use o remetente de teste onboarding@resend.dev
MAIL_FROM="Radar <radar@exemplo.com>"
MAIL_BCC=""

# ── Agendador ─────────────────────────────────────────────────────
SCHEDULER_CRON="0 8 * * 1-5"
SCHEDULER_TZ="America/Sao_Paulo"
APP_URL="http://localhost:3000"
CRON_SECRET=""
